fpath=("$HOMEBREW_PREFIX/share/zsh-completions" $fpath)
autoload -Uz compinit && compinit

# Disabled: atuin owns Ctrl-R. This also drops fzf's Ctrl-T and Alt-C.
# source <(fzf --zsh)
source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000

export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"
export UV_LOCKED=1

# Options
setopt APPEND_HISTORY       # Don't overwrite history
setopt SHARE_HISTORY        # Share history between all sessions
setopt HIST_IGNORE_ALL_DUPS # Keep it clean
setopt HIST_REDUCE_BLANKS   # Remove wasted space


# Aliases
alias ls="eza --icons --group-directories-first"
alias ll="eza -lh --icons --git"
alias cat="bat"
alias grep="rg"
alias find="fd"
alias docker="podman"


eval "$(starship init zsh)"
eval "$(mise activate zsh)"
eval "$(zoxide init zsh)"

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

eval "$(atuin init zsh --disable-up-arrow)"

# Must be sourced last: it wraps every widget defined before it.
source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
